# Copy to .env and fill in. .env is git-ignored.

# prod = real money. uat = True Markets sandbox (paper funds), if your account has UAT access.
TM_ENV=prod

# Path to the API key JSON you downloaded from app.truemarkets.co/settings/api-keys.
# Keep it OUTSIDE this repo (e.g. ~/.truemarkets/api-key.json).
TM_KEY_FILE=~/.truemarkets/api-key.json

# Turn off the official SDK telemetry if you ever use it.
TM_TELEMETRY=0
